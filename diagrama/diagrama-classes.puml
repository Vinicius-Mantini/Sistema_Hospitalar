@startuml diagrama-classes
 title Sistema Hospitalar — Sprint 2 (modelo atualizado)
 skinparam classAttributeIconSize 0
 hide empty members

 abstract class ProfissionalSaude {
   - id: Long
   - nome: String
   - registroConselho: String
   - telefone: String
   - email: String
   - ativo: boolean
   + estaDisponivel(): boolean
 }
 class MedicoClinicoGeral {
   + encaminharPaciente(paciente, especialista, motivo): Encaminhamento
 }
 class MedicoEspecialista {
   - especialidade: String
 }
 class Cirurgiao {
   - areaCirurgica: String
   + registrarProcedimento(procedimento)
 }
 ProfissionalSaude <|-- MedicoClinicoGeral
 ProfissionalSaude <|-- MedicoEspecialista
 ProfissionalSaude <|-- Cirurgiao

 class Paciente {
   - id: Long
   - nome: String
   - cpf: String
   - dataNascimento: LocalDate
   - telefone: String
   - email: String
 }
 class Encaminhamento {
   - id: Long
   - dataHora: LocalDateTime
   - motivo: String
 }
 Paciente "1" -- "0..*" Encaminhamento
 MedicoClinicoGeral "1" -- "0..*" Encaminhamento : origem
 MedicoEspecialista "1" -- "0..*" Encaminhamento : destino

 abstract class Atendimento {
   - id: Long
   - dataHora: LocalDateTime
   - status: StatusAtendimentoEnum
   + validarCondicoes(): boolean
   + alterarStatus(novoStatus)
 }
 class ConsultaRotina {
   - motivo: String
   - observacoes: String
   + validarCondicoes(): boolean
 }
 class ConsultaEspecializada {
   - especialidade: String
   - observacoes: String
   + validarCondicoes(): boolean
 }
 class AtendimentoEmergencia {
   - prioridade: PrioridadeEnum
   - statusEmergencia: StatusEmergenciaEnum
   + validarCondicoes(): boolean
   + iniciar()
   + concluir()
 }
 class ProcedimentoCirurgico {
   - descricao: String
   - tipoCirurgia: String
   - observacoesPreOperatorias: String
   - observacoesPosOperatorias: String
   - dataHoraEfetiva: LocalDateTime
   - statusProcedimento: StatusProcedimentoEnum
   + validarCondicoes(): boolean
   + iniciar()
   + concluir()
   + cancelar()
 }
 Atendimento <|-- ConsultaRotina
 Atendimento <|-- ConsultaEspecializada
 Atendimento <|-- AtendimentoEmergencia
 Atendimento <|-- ProcedimentoCirurgico
 Paciente "1" -- "0..*" Atendimento
 ProfissionalSaude "1" -- "0..*" Atendimento : responsável

 class HistoricoMedico {
   - id: Long
   - paciente: Paciente
   - atendimentos: List<Atendimento>
   - internacoes: List<Internacao>
   + adicionarAtendimento()
   + adicionarInternacao()
 }
 Paciente "1" *-- "1" HistoricoMedico
 HistoricoMedico o-- "0..*" Atendimento
 HistoricoMedico o-- "0..*" Internacao

 class Quarto {
   - id: Long
   - numero: String
   - tipo: TipoQuartoEnum
   - capacidade: int
   - leitosOcupados: int
   - situacao: SituacaoQuartoEnum
   - versao: long
   + temVagaDisponivel(): boolean
   + ocuparLeito()
   + liberarLeito()
   + colocarEmManutencao()
   + reativar()
 }
 class Internacao {
   - id: Long
   - dataEntrada: LocalDateTime
   - dataAlta: LocalDateTime
   - situacao: SituacaoInternacaoEnum
   - observacoes: String
   + registrarAlta()
   + cancelar()
 }
 Paciente "1" -- "0..*" Internacao
 Quarto "1" -- "0..*" Internacao

 enum StatusAtendimentoEnum {
   AGENDADA
   CONFIRMADA
   EM_ATENDIMENTO
   CONCLUIDA
   CANCELADA
   NAO_COMPARECEU
 }
 enum PrioridadeEnum {
   BAIXA
   MODERADA
   ALTA
   CRITICA
 }
 enum StatusEmergenciaEnum {
   AGUARDANDO
   INICIADO
   CONCLUIDO
 }
 enum StatusProcedimentoEnum {
   AGENDADO
   EM_ANDAMENTO
   CONCLUIDO
   CANCELADO
 }
 enum SituacaoQuartoEnum {
   DISPONIVEL
   OCUPADO
   MANUTENCAO
 }
 enum TipoQuartoEnum {
   ENFERMARIA
   APARTAMENTO
   UTI
 }
 enum SituacaoInternacaoEnum {
   ATIVA
   ALTA
   CANCELADA
 }

 Atendimento ..> StatusAtendimentoEnum
 AtendimentoEmergencia ..> PrioridadeEnum
 AtendimentoEmergencia ..> StatusEmergenciaEnum
 ProcedimentoCirurgico ..> StatusProcedimentoEnum
 Quarto ..> SituacaoQuartoEnum
 Quarto ..> TipoQuartoEnum
 Internacao ..> SituacaoInternacaoEnum
 @enduml
